{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "server",
    "web",
    "scripts",
    "tests",
    "*.ts"
  ]
}
