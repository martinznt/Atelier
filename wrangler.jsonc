{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atelier",
  "main": "server/index.ts",
  "compatibility_date": "2025-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/oauth/*",
      "/.well-known/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atelier-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TASKS",
        "queue": "atelier-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "atelier-tasks",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 0
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "ALLOW_REGISTRATION": "true",
    "STORAGE_LIMIT_MB": "20",
    "MAX_FILE_MB": "0.25"
  },
  "observability": {
    "enabled": false
  },
  "previews": {
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "ALLOW_REGISTRATION": "false",
    "STORAGE_LIMIT_MB": "20",
    "MAX_FILE_MB": "0.25"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atelier-db-test",
      "database_id": "098e53fe-0479-4084-87b1-81951d857fea",
      "migrations_dir": "migrations"
    }
  ]
}
}
